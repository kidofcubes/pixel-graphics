layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

uniform int lightCount;
uniform int frame;

#define COMPUTE_MULTIPLIER_PORPORTION (float(COMPUTE_MULTIPLIER) / float(max(lightCount,1)))

layout (r32ui, binding = 0) uniform uimage2D computeAccuR;
layout (r32ui, binding = 1) uniform uimage2D computeAccuG;
layout (r32ui, binding = 2) uniform uimage2D computeAccuB;

layout (std430) readonly restrict buffer scene {
    PixelData scene_pixels[];
};

layout (std430) readonly restrict buffer sortedRays {
    Ray rays_in[];
};

layout (std430) readonly restrict buffer tileStart {
    uint tile_start[];
};

layout (std430) readonly restrict buffer tileCount {
    uint tile_count[];
};

layout (std430, binding = 11) restrict buffer outputQueue {
    Ray queue_b[];
};

layout (std430, binding = 13) restrict buffer outputCount {
    uint queue_b_count;
};

shared uint accum_r[TILE_PIXELS];
shared uint accum_g[TILE_PIXELS];
shared uint accum_b[TILE_PIXELS];

void emit_to_queue_b(vec2 pos, vec2 dir, vec3 energy) {
    if (max(max(energy.x, energy.y), energy.z) <= 0.00001) return;
    // Nudge across the cell boundary along dir. After a leftward/downward DDA step,
    // pos lands exactly on the integer edge that bounds the new cell from above —
    // which is *outside* the half-open cell [mp, mp+1). Without this nudge,
    // tile_id_of(pos) and the next wave's mp = int(pos) both snap back to the
    // tile we just exited, producing an infinite ping-pong for left/down rays.
    vec2 emit_pos = pos + dir * 1e-3;
    uint slot = atomicAdd(queue_b_count, 1u);
    if (slot >= MAX_RAYS) return;
    Ray r;
    r.position = emit_pos;
    r.direction = dir;
    r.energy = energy;
    r.tile_id = tile_id_of(emit_pos);
    queue_b[slot] = r;
}

void march_ray(in Ray ray, int tile_x0, int tile_y0) {
    vec2 pos = ray.position;
    vec2 dir = ray.direction;
    vec3 energy = ray.energy;

    if (dir.x == 0.0) dir.x = FLT_MIN;
    if (dir.y == 0.0) dir.y = FLT_MIN;

    int stepX = dir.x > 0.0 ? 1 : -1;
    int stepY = dir.y > 0.0 ? 1 : -1;
    int offX  = dir.x > 0.0 ? 1 : 0;
    int offY  = dir.y > 0.0 ? 1 : 0;

    ivec2 mp = ivec2(int(pos.x), int(pos.y));
    int tile_x1 = tile_x0 + TILE_W;
    int tile_y1 = tile_y0 + TILE_H;

    float rngState = noise2(pos.x + float(frame) * 0.013, pos.y + float(frame) * 0.027);

    int maxSteps = (TILE_W + TILE_H) * 4;
    for (int s = 0; s < maxSteps; s++) {
        float dtX = (float(mp.x + offX) - pos.x) / dir.x;
        float dtY = (float(mp.y + offY) - pos.y) / dir.y;
        float dt = min(dtX, dtY);
        bool stepIsX = dtX < dtY;
        if (stepIsX) { mp.x += stepX; } else { mp.y += stepY; }
        pos += dir * dt;
        float pixel_length = length(dir * dt);

        // Out of image entirely: drop.
        if (mp.x < 0 || mp.x >= RESOLUTIONX || mp.y < 0 || mp.y >= RESOLUTIONY) return;

        // Exited tile: enqueue to next wave.
        if (mp.x < tile_x0 || mp.x >= tile_x1 || mp.y < tile_y0 || mp.y >= tile_y1) {
            emit_to_queue_b(pos, dir, energy);
            return;
        }

        PixelData px = scene_pixels[mp.x + mp.y * RESOLUTIONX];
        int local_idx = (mp.x - tile_x0) + (mp.y - tile_y0) * TILE_W;

        if (px.density < 1.0) {
            if (px.density == 0.0) continue;
            vec3 scattered = energy * px.scattering * px.density;
            atomicAdd(accum_r[local_idx], uint(scattered.r * COMPUTE_MULTIPLIER_PORPORTION));
            atomicAdd(accum_g[local_idx], uint(scattered.g * COMPUTE_MULTIPLIER_PORPORTION));
            atomicAdd(accum_b[local_idx], uint(scattered.b * COMPUTE_MULTIPLIER_PORPORTION));

            energy.r *= exp(-(px.scattering.r + px.absorption.r) * px.density * pixel_length);
            energy.g *= exp(-(px.scattering.g + px.absorption.g) * px.density * pixel_length);
            energy.b *= exp(-(px.scattering.b + px.absorption.b) * px.density * pixel_length);

            rngState = noise2(rngState, float(s) + pos.x);
            float roll = fract(rngState);
            float maxScat = max(max(px.scattering.x, px.scattering.y), px.scattering.z);
            if (roll < maxScat * px.density * pixel_length) {
                float g = 0.75;
                float newAng = sampleBiasedAngle(atan(dir.y, dir.x), g, noise3(rngState, pos.x, pos.y));
                dir = vec2(cos(newAng), sin(newAng));
                if (dir.x == 0.0) dir.x = FLT_MIN;
                if (dir.y == 0.0) dir.y = FLT_MIN;
                stepX = dir.x > 0.0 ? 1 : -1;
                stepY = dir.y > 0.0 ? 1 : -1;
                offX  = dir.x > 0.0 ? 1 : 0;
                offY  = dir.y > 0.0 ? 1 : 0;
            }
            continue;
        }

        // Surface hit
        vec2 normal = stepIsX ? vec2(-float(stepX), 0.0) : vec2(0.0, -float(stepY));
        float reflChance = px.reflectiveness;
        float transChance = px.transmission;
        vec3 diffuseColor = mix(px.color, vec3(0.0), px.metallic);
        vec3 absorbed = energy * diffuseColor;
        atomicAdd(accum_r[local_idx], uint(absorbed.r * pixel_length * COMPUTE_MULTIPLIER_PORPORTION));
        atomicAdd(accum_g[local_idx], uint(absorbed.g * pixel_length * COMPUTE_MULTIPLIER_PORPORTION));
        atomicAdd(accum_b[local_idx], uint(absorbed.b * pixel_length * COMPUTE_MULTIPLIER_PORPORTION));

        rngState = noise2(rngState, float(s) + pos.x);
        float roll = rngState;
        if (roll < reflChance) {
            vec2 refDir = reflect(dir, normal);
            float jitter = (noise2vec(vec2(rngState, float(s) + 1.0)) - 0.5) * px.roughness * PI;
            dir = rotate2d(refDir, jitter);
            if (dot(dir, normal) < 0.0) dir = reflect(dir, normal);
            vec3 specularColor = mix(vec3(1.0), px.color, px.metallic);
            energy *= specularColor;
            if (dir.x == 0.0) dir.x = FLT_MIN;
            if (dir.y == 0.0) dir.y = FLT_MIN;
            stepX = dir.x > 0.0 ? 1 : -1;
            stepY = dir.y > 0.0 ? 1 : -1;
            offX  = dir.x > 0.0 ? 1 : 0;
            offY  = dir.y > 0.0 ? 1 : 0;
        } else if (roll < reflChance + transChance) {
            energy *= 1.0 - ((1.0 - px.transmission) * pixel_length);
        } else {
            return;
        }
    }
    // Hit step cap inside tile; drop.
}

void main() {
    uint tid = gl_WorkGroupID.x;
    if (tid >= uint(TILE_COUNT)) return;

    // Clear shared accumulators
    for (uint i = gl_LocalInvocationID.x; i < uint(TILE_PIXELS); i += gl_WorkGroupSize.x) {
        accum_r[i] = 0u;
        accum_g[i] = 0u;
        accum_b[i] = 0u;
    }
    barrier();

    uint count = tile_count[tid];
    int tile_x0 = int(tid % uint(TILES_PER_ROW)) * TILE_W;
    int tile_y0 = int(tid / uint(TILES_PER_ROW)) * TILE_H;

    if (count > 0u) {
        uint start = tile_start[tid];
        uint n = min(count, uint(MAX_RAYS_PER_TILE_PER_WAVE));
        for (uint r = gl_LocalInvocationID.x; r < n; r += gl_WorkGroupSize.x) {
            Ray ray = rays_in[start + r];
            march_ray(ray, tile_x0, tile_y0);
        }
        // Leftover rays past the cap: forward to next wave unchanged.
        for (uint r = n + gl_LocalInvocationID.x; r < count; r += gl_WorkGroupSize.x) {
            Ray ray = rays_in[start + r];
            uint slot = atomicAdd(queue_b_count, 1u);
            if (slot < uint(MAX_RAYS)) {
                queue_b[slot] = ray;
            }
        }
    }
    barrier();

    // Flush shared accumulators to global image. Only this workgroup touches these
    // pixels this wave, so a load+add+store is safe (no atomic needed within a wave).
    for (uint i = gl_LocalInvocationID.x; i < uint(TILE_PIXELS); i += gl_WorkGroupSize.x) {
        int lx = int(i) % TILE_W;
        int ly = int(i) / TILE_W;
        ivec2 gp = ivec2(tile_x0 + lx, tile_y0 + ly);
        if (gp.x >= RESOLUTIONX || gp.y >= RESOLUTIONY) continue;
        uint r = accum_r[i];
        uint g = accum_g[i];
        uint b = accum_b[i];
        if (r != 0u) imageStore(computeAccuR, gp, uvec4(imageLoad(computeAccuR, gp).x + r));
        if (g != 0u) imageStore(computeAccuG, gp, uvec4(imageLoad(computeAccuG, gp).x + g));
        if (b != 0u) imageStore(computeAccuB, gp, uvec4(imageLoad(computeAccuB, gp).x + b));
    }
}
