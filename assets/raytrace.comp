#define FLT_MAX 3.402823466e+38
#define FLT_MIN 1.175494351e-38


layout (std430) readonly restrict buffer scene
{
// We group the 12 floats into an array of vec4s for clearer alignment.
// NOTE: The struct below must perfectly match the Rust struct's memory layout (48 bytes)
    PixelData scene_pixels[]; // The array of all pixels in your scene
};

PixelData get_pixel(ivec2 pos){
    return scene_pixels[pos.x+(pos.y*RESOLUTIONX)];
}

// --- Helper: 2D Rotation ---
vec2 rotate2d(vec2 v, float a) {
    float s = sin(a);
    float c = cos(a);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}

// GLSL side UBO definition
layout(std140) uniform lightList { // Choose an available binding index
    LightPoint light_points[MAX_LIGHTS]; // MAX_LIGHTS must match the array size reserved on GPU
};

uniform int lightCount; // Standard uniform to tell the shader how many lights are active

#define COMPUTE_MULTIPLIER_PORPORTION (float(COMPUTE_MULTIPLIER) / float(lightCount))


// NEW: Function to generate a biased random angle (Simplified 2D HG-like sampling)
float sampleBiasedAngle(float currentAngle, float g, float rngValue) {
    // This is a simplified, non-physically-based bias, but it demonstrates the concept
    // of making the new angle dependent on the old angle and the anisotropy (g).

    // Convert random value (0 to 1) to a scatter angle (-PI to PI)
    float uniformScatterAngle = (rngValue - 0.5) * 2.0 * PI;

    // Mix the uniform angle with 0.0 (perfect forward) based on the anisotropy 'g'.
    // A small 'g' means mostly uniform; a large 'g' means mostly forward.
    float biasedScatterAngle = mix(uniformScatterAngle, 0.0, abs(g));

    // Combine with the current angle
    return currentAngle + biasedScatterAngle;
}



void pathTracing(in vec2 initPos, in vec2 dir, vec3 currentLight, in float seed){



    // -1 to compensate for 1-indexed tile coordinates
    int tileOffsetX = (dir.x > 0.0 ? 1 : 0);
    int tileOffsetY = (dir.y > 0.0 ? 1 : 0);

    int stepX = dir.x > 0.0 ? 1 : -1;
    int stepY = dir.y > 0.0 ? 1 : -1;

    vec2 curPos = initPos;
    float t = 0.0;

    if(dir.x==0.0){
        dir.x = FLT_MIN;
    }
    if(dir.y==0.0){
        dir.y = FLT_MIN;
    }

    ivec2 movingPos = ivec2(int(initPos.x),int(initPos.y));
    float dist = length(curPos-initPos);
    PixelData currentPixel = get_pixel(movingPos);

//    if(currentPixel.opac)
//    imageAtomicAdd(computeAccuR,movingPos,uint(currentLight.r * float(COMPUTE_MULTIPLIER_PORPORTION)));
//    imageAtomicAdd(computeAccuG,movingPos,uint(currentLight.g * float(COMPUTE_MULTIPLIER_PORPORTION)));
//    imageAtomicAdd(computeAccuB,movingPos,uint(currentLight.b * float(COMPUTE_MULTIPLIER_PORPORTION)));

    float rngState = seed;

    int side = 0;

    for(int i=0;i<(int(LIGHT_MAX_RADIUS*2.0));i++) {
//        if(length(currentLight) < 170.0){
//            return;
//        }
        float dtX = (float(movingPos.x+tileOffsetX) - curPos.x) / dir.x; // distances to next borders
        float dtY = (float(movingPos.y+tileOffsetY) - curPos.y) / dir.y; // distances to next borders
        float dt = min(dtX, dtY);
        if(dtX < dtY){
            t = t + dtX;
            movingPos.x+=stepX;
        }else{
            t = t + dtY;
            movingPos.y+=stepY;
        }

        if(movingPos.x < 0 || movingPos.x >= RESOLUTIONX || movingPos.y < 0|| movingPos.y >= RESOLUTIONY){
            return;
        }

        curPos += dir*min(dtX, dtY);
        float pixel_length = length(dir*min(dtX, dtY));
        currentPixel = get_pixel(movingPos);

        // A. Basic Density/Opacity Check
        // If the cell is effectively empty, the ray travels through the volume
        if(currentPixel.density < 1.0) {
            if(currentPixel.density==0.0){
                continue;
            }
            // --- VOLUMETRIC SCATTERING (In-Scattering) ---

            // 1. Calculate scattered light (light made visible)
            // Energy scattered = Current Light * Density * Distance Traveled
            // 2.0 because i want the air to be brighter
//            float scatteringRate = 1.0 * ((1.0-currentPixel.transmission) * pixel_length);

            // Apply a tint to the volume/air itself for effect (e.g., blueish/fog)
            vec3 volumeColor = currentPixel.color.rgb;
            float phase = 1.0;
//            vec3 scatteredLight = currentLight * currentPixel.scattering * (max(currentPixel.density,0.05)) * phase;
            vec3 scatteredLight = currentLight * currentPixel.scattering * (max(currentPixel.density,0.00)) * phase;
            //            vec3 scatteredLight = min(currentLight,vec3(10.0,10.0,10.0)) * scatteringRate * volumeColor;

            // 2. Deposit the scattered light into the accumulator
            // This is the core step that makes the ray visible in the grid cell.
            imageAtomicAdd(computeAccuR,movingPos,uint(scatteredLight.r * float(COMPUTE_MULTIPLIER_PORPORTION)));
            imageAtomicAdd(computeAccuG,movingPos,uint(scatteredLight.g * float(COMPUTE_MULTIPLIER_PORPORTION)));
            imageAtomicAdd(computeAccuB,movingPos,uint(scatteredLight.b * float(COMPUTE_MULTIPLIER_PORPORTION)));



            currentLight.r *= exp(-(currentPixel.scattering.r + currentPixel.absorption.r) * currentPixel.density * pixel_length);
            currentLight.g *= exp(-(currentPixel.scattering.g + currentPixel.absorption.g) * currentPixel.density * pixel_length);
            currentLight.b *= exp(-(currentPixel.scattering.b + currentPixel.absorption.b) * currentPixel.density * pixel_length);
//            currentLight *= 1.0-((1.0-currentPixel.transmission) * pixel_length);


            // 3. Apply Attenuation (Light loss from the ray)
            // The light remaining in the ray path must be reduced.
            //            float attenuationFactor = exp(-(0.005) * dt);
            //            currentLight *= attenuationFactor;

            // 4. Check for Re-scatter (Ray Bounce in Air)
            rngState = noise2(rngState,t); // Update RNG state
            float rollVolumetric = fract(rngState);

//            if ((rollVolumetric < 0.05 && sunMode==0)||(rollVolumetric < 0.025 && sunMode==1)) {
//            if (rollVolumetric < -100||(rollVolumetric < length(currentPixel.scattering) * currentPixel.density * pixel_length)) {
            if (rollVolumetric < max(currentPixel.scattering.x,max(currentPixel.scattering.y,currentPixel.scattering.z)) * currentPixel.density * pixel_length) {
//            if (rollVolumetric < -100) {
                // If rolled true, change direction randomly (like a diffuse bounce)

                // New random direction
                float g = 0.8;
                if(sunMode==1){
                    g = 0.98;
                }
                g=0.75;
//                g=1.0;
                float newRandomDir = sampleBiasedAngle(atan(dir.y,dir.x), g, noise3(rngState, curPos.x, curPos.y));
                dir = vec2(cos(newRandomDir), sin(newRandomDir));

                // Recalculate DDA steps for the new direction
                tileOffsetX = (dir.x > 0.0 ? 1 : 0);
                tileOffsetY = (dir.y > 0.0 ? 1 : 0);
                stepX = dir.x > 0.0 ? 1 : -1;
                stepY = dir.y > 0.0 ? 1 : -1;

                // IMPORTANT: Since the light bounced, we can optionally apply a slight
                // loss of energy to simulate the inefficiencies of the scatter.
                // currentLight *= 0.9; // Optional energy reduction
            }
            continue;
        }

        vec2 normal = vec2(0.0);
        if(side == 0) normal = vec2(-float(stepX), 0.0);
        else          normal = vec2(0.0, -float(stepY));


        //simulate light
        float reflChance = currentPixel.reflectiveness; // 0.0 to 1.0
        float transChance = currentPixel.transmission;  // 0.0 to 1.0

        vec3 diffuseColor = mix(currentPixel.color.rgb, vec3(0.0), currentPixel.metallic);
        //        vec3 absorbedEnergy = currentLight * (1.0 - reflChance - transChance) * diffuseColor * opacity;
        //        vec3 absorbedEnergy = currentLight * (1.0 - reflChance) * diffuseColor * opacity;
        vec3 absorbedEnergy = currentLight * (1.0) * diffuseColor;


        imageAtomicAdd(computeAccuR,movingPos,uint(absorbedEnergy.r * pixel_length * float(COMPUTE_MULTIPLIER_PORPORTION)));
        imageAtomicAdd(computeAccuG,movingPos,uint(absorbedEnergy.g * pixel_length * float(COMPUTE_MULTIPLIER_PORPORTION)));
        imageAtomicAdd(computeAccuB,movingPos,uint(absorbedEnergy.b * pixel_length * float(COMPUTE_MULTIPLIER_PORPORTION)));

        rngState = noise2(rngState,t);
        float roll = rngState;
        //assums reflectiveness + transmission add up to 1.0 or less
        if (roll < reflChance) {
            // --- REFLECTION ---

            // 1. Perfect reflection vector
            vec2 refDir = reflect(dir, normal);

            // 2. Apply Roughness (Jitter angle)
            float jitter = (noise2vec(vec2(rngState, t + 1.0)) - 0.5) * currentPixel.roughness * PI;
            dir = rotate2d(refDir, jitter);

            // 3. Ensure we don't reflect *into* the wall (due to roughness jitter)
            if(dot(dir, normal) < 0.0) {
                dir = reflect(dir, normal);
            }

            // 4. Update Light Color (Fresnel / Metal tint)
            vec3 specularColor = mix(vec3(1.0), currentPixel.color.rgb, currentPixel.metallic);
            currentLight *= specularColor;

            // Recalculate tile offsets for new direction
            tileOffsetX = (dir.x > 0.0 ? 1 : 0);
            tileOffsetY = (dir.y > 0.0 ? 1 : 0);
            stepX = dir.x > 0.0 ? 1 : -1;
            stepY = dir.y > 0.0 ? 1 : -1;

        } else if (roll < reflChance + transChance) {
            // --- TRANSMISSION ---
            // Pass through with some attenuation based on color
            //            currentLight *= currentPixel.color.rgb;
            //            currentLight *= pow(normalize(currentPixel.color.rgb) * sqrt(3), vec3(opacity)) * 0.25;
            //            currentLight *= pow(normalize(currentPixel.color.rgb), vec3(opacity));
            // Keep 'dir' same for simple transmission.
            currentLight *= 1.0-((1.0-currentPixel.transmission) * pixel_length);

        } else {
            // --- ABSORPTION (Ray Death) ---
            // The light was fully absorbed by the surface. Stop tracing.
            return;
        }
    }
}




//i generate the random dir
void pathTracing(in ivec2 pos, in float seed){
    float initSeed = noise2(float(frame)/1000.0,seed);
    vec2 initPos = vec2(pos);
    initPos.x += noise3(initSeed,initPos.x,initPos.y);
    initPos.y += noise3(initSeed,initPos.x,initPos.y);

    float randomDir = noise3(initSeed,initPos.x,initPos.y)*2.0*PI;
    vec2 dir = vec2(cos(randomDir),sin(randomDir));

    PixelData currentPixel = get_pixel(pos);
    vec3 currentLight = currentPixel.color.rgb * currentPixel.emissiveness;

    pathTracing(initPos, dir, currentLight, initSeed);
}

