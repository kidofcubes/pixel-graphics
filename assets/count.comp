layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 10) readonly restrict buffer inputQueue {
    Ray q_in[];
};
layout(std430, binding = 12) readonly restrict buffer inputCount {
    uint cnt_in;
};

layout(std430) restrict buffer tileCount {
    uint tile_count[];
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= cnt_in) return;
    uint tid = q_in[gid].tile_id;
    if (tid >= uint(TILE_COUNT)) return;
    atomicAdd(tile_count[tid], 1u);
}
